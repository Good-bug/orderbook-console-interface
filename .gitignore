# --- Build outputs ---
/build/
/cmake-build-*/          # Default CLion build directories when no preset is used
/out/
/vcpkg_installed/        # vcpkg manifest mode

# --- Local CMake settings ---
# CMakeUserPresets.json is not intended to be committed.
# CMakePresets.json remains in the repository.
/CMakeUserPresets.json

# --- CLion / JetBrains ---
/.idea
*.iml
*.iws
/.vscode

# --- clangd / indexes / compile_commands ---
/.cache/
/.clangd/
/compile_commands.json

# --- Profiling and dumps ---
perf.data
perf.data.*
*.perf
core.[0-9]*              # Avoid core.* to prevent matching src/core.cpp

# --- Benchmark results that are not project artifacts ---
/bench-out/

# --- OS / editors ---
.DS_Store
*.swp
*~

# --- Data dumps ---
*.csv
*.log
